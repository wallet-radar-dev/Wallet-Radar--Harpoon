# Розташування сховища Wallet Radar (скопіювати у store.env і підставити свої шляхи).
#
# WR_DB         — основна база. Клади на великий диск: на системному може не стати місця.
# WR_DB_MIRRORS — куди дзеркалити, через ";". Сенс у тому, щоб від'єднаний
#                 зовнішній диск не забирав із собою ЄДИНУ копію.
# WR_SEED       — куди `wr-import extract` кладе видобуті таблиці. Тримай ПОЗА
#                 текою репозиторію: там ті самі адреси, що ми виносимо з коду.
# WR_REPO       — корінь репозиторію, звідки читаються .rs при видобуванні.
#
# Слеші ПРЯМІ. Зворотні з'їдаються оболонкою при `source`, шлях мовчки стає
# відносним, і копія лягає не туди — перевірено дослідом. Тепер такий шлях
# відхиляється, але краще не наступати взагалі.
#
# Дзеркало робиться через VACUUM INTO, а не копіюванням файла: база в режимі WAL
# тримає свіжі транзакції в окремому -wal, тож звичайний copy дав би зіпсований
# або мовчки застарілий знімок.

WR_DB=D:/wr-live/store/wallet-radar.db
WR_DB_MIRRORS=C:/Users/<user>/wallet-radar-store/wallet-radar.db
WR_SEED=D:/wr-live/store/seed
WR_REPO=C:/Users/<user>/wallet-tracker
