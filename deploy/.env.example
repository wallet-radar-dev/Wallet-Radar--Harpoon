# Скопіюйте у deploy/.env і заповніть. Це ЄДИНЕ місце, де живуть ключі до зовнішніх API —
# у .env кора їх немає й бути не повинно (docs/satellites.md).
#
# Перевірити перед стартом: deploy/check-satellite-env.sh
#
# ГОЛОВНЕ: SAT_A_* і SAT_B_* мусять бути РІЗНИМИ ключами. Квота Etherscan (5 запитів/с)
# прив'язана до КЛЮЧА, а не до IP чи машини. Два сателіти з ОДНАКОВИМ ключем не дають
# подвоєння — лише другий IP і резерв на випадок падіння. Саме заради множення квоти все
# це й будувалося, тож однакові ключі тихо знецінюють половину роботи.
#
# Порожній ключ — не помилка: сателіт чесно віддасть configured=false у Health, а Fetch
# поверне виразну помилку. Мовчазна порожня відповідь виглядала б як «даних немає».

# ── Сателіт A ──
SAT_A_ETHERSCAN_API_KEY=
SAT_A_MORALIS_API_KEY=
SAT_A_LUNARCRUSH_API_KEY=
SAT_A_ARKHAM_API_KEY=
SAT_A_GLASSNODE_API_KEY=

# ── Сателіт B (ІНШІ ключі, не копії A) ──
SAT_B_ETHERSCAN_API_KEY=
SAT_B_MORALIS_API_KEY=
SAT_B_LUNARCRUSH_API_KEY=
SAT_B_ARKHAM_API_KEY=
SAT_B_GLASSNODE_API_KEY=
