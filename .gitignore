# Secrets. Never commit — this file holds live API keys and passwords.
.env

# Резервні копії .env — те саме, що ключі й паролі, тільки в іншому файлі.
# Створюються перед ризикованими змінами, але в репозиторій потрапляти не мусять.
.env.bak*
.env.*.bak*
*.env.bak*

# Reinstallable from package-lock.json
node_modules/

# Local machine settings
.claude/settings.local.json
.claude/*.tmp.*

# Editor / OS noise
*.swp
.DS_Store

# Never commit anything that looks like a raw credential dump
docker/glitchtip.docker-compose.yml

# Rust build artifacts
rust-server/target/
satellite/target/
gat/target/

# Frontend build artifacts — generated by `npm run build` (esbuild + tailwind).
# Source lives in web/src/*.ts + web/tw-input.css. Build before serving.
web/app.js
web/app.js.map
web/app.css

# mTLS PKI — приватні ключі та видані сертифікати НЕ комітимо
deploy/pki/out/
deploy/.env
# Секрети GlitchTip (SECRET_KEY + пароль БД) — НЕ комітимо
deploy/.env.glitchtip

# Соц-кеш LunarCrush (prices.rs). На диску він ЖИВЕ навмисно — квота 100 викликів/добу, і без
# збереження кожен рестарт палив би 30 із них наново. Але в РЕПО йому робити нічого: файл
# перезаписується на кожен виклик (чистий шум у діфах), а записи протухають за 12 годин.
# Свідомо інакше, ніж dataset/cache.json, який історично закомічений.
dataset/social-cache.json

# Добові знімки датасету від backup-воркера. Він же їх і ротує, тож у git вони давали
# лише шум: кожен прогін = сотня нових файлів і сотня видалень старих. На диску потрібні
# (звідти відновлюємось), у репо — ні. Історія датасету і так у комітах dataset/*.json.
dataset/.backups/
.claude/hooks/compress-large-images/target/
backfill/target/
wr-store/target/
wr-dict/target/

# Оперативний стан Telegram-бота: реєстр підключених (chat_id, імена — персональні
# дані), зсув і курсори доставки. У репозиторій їм не місце.
deploy/telegram-users.json
dataset/telegram-users.json
deploy/telegram-offset.txt
deploy/telegram-signal-cursor.json
deploy/telegram-signal-cursors.json

# Журнал команд бота
deploy/bot-commands.log

# Стан моніторів (cexsignal, wakeup) — перезаписується під час роботи
deploy/*.state.json

# GlitchTip: у compose-файлі пароль БД і SECRET_KEY — НЕ комітимо
deploy/docker-compose.glitchtip.yml

# Тимчасові знімки прогресу воркерів — лише шум у дифах
dataset/.cg-universe*.json
dataset/.quota-report-*.txt
dataset/.whale-hunt-mc-progress.json

# Стан campwatch — перезаписується на кожному прогоні
dataset/backfill/campwatch-state.json
