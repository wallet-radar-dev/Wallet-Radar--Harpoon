# Secrets. Never commit — this file holds live API keys and passwords.
.env

# Reinstallable from package-lock.json
node_modules/

# Local machine settings
.claude/settings.local.json
.claude/*.tmp.*

# Editor / OS noise
*.swp
.DS_Store

# Never commit anything that looks like a raw credential dump
docker/glitchtip.docker-compose.yml

# Rust build artifacts
rust-server/target/
satellite/target/
gat/target/

# Frontend build artifacts — generated by `npm run build` (esbuild + tailwind).
# Source lives in web/src/*.ts + web/tw-input.css. Build before serving.
web/app.js
web/app.js.map
web/app.css

# mTLS PKI — приватні ключі та видані сертифікати НЕ комітимо
deploy/pki/out/
deploy/.env

# Соц-кеш LunarCrush (prices.rs). На диску він ЖИВЕ навмисно — квота 100 викликів/добу, і без
# збереження кожен рестарт палив би 30 із них наново. Але в РЕПО йому робити нічого: файл
# перезаписується на кожен виклик (чистий шум у діфах), а записи протухають за 12 годин.
# Свідомо інакше, ніж dataset/cache.json, який історично закомічений.
dataset/social-cache.json

# Добові знімки датасету від backup-воркера. Він же їх і ротує, тож у git вони давали
# лише шум: кожен прогін = сотня нових файлів і сотня видалень старих. На диску потрібні
# (звідти відновлюємось), у репо — ні. Історія датасету і так у комітах dataset/*.json.
dataset/.backups/
.claude/hooks/compress-large-images/target/
backfill/.backfill.env

# Архів прибраних dev-артефактів (cleanup 2026-07-26). Відновлення: mv old/<шлях> <шлях>
old/

# Тимчасові файли атомарного запису (atomicw). Осиротіти можуть лише при краху.
*.tmp.*

# Секрети: ловимо БУДЬ-ЯКИЙ *.env, а не перелічені три. Перелік уже раз підвів —
# deploy/backfill.env і deploy/core.env лишались поза ним із живими ключами.
*.env
!*.env.example
# Файл сховища: значень секретів у ньому немає (вони в Credential Manager),
# але дані досліджень туди не комітимо.
wallet-radar.db
wallet-radar.db-wal
wallet-radar.db-shm

# Проміжні файли переїзду в БД. Містять ТІ САМІ адреси, що ми виносимо з коду —
# закомітити їх означало б перенести витік із .rs у .json. Відтворюються
# командою `wr-import extract`, поки код ще тримає ці таблиці; далі джерело — БД.
wr-store/seed/

# Правило `*.env` НЕ ловить копії виду `.env.20260716-192604` — файл закінчується
# не на .env. Саме так у теці deploy/backups/ лежав живий TELEGRAM_BOT_TOKEN
# і обидва паролі, поза git, але й поза будь-яким правилом.
.env.*
!.env.example
deploy/backups/

# Ретро-реплей сигналів: десятки тисяч рядків, які щоразу відтворюються біном sigretro
# з історії біржі. У git тримаємо ЖИВИЙ журнал (dataset/signals.jsonl) — він неповторний.
dataset/retro/

# Артефакти збірки БУДЬ-ЯКОГО крейта. Перелік по одному (rust-server/, satellite/, gat/)
# уже підвів: wr-store/target і patterns/target у ньому не значились, і при першій же
# спробі закомітити крейт в індекс полізли тисячі файлів .fingerprint.
target/
