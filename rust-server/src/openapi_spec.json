{"openapi":"3.0.3","info":{"title":"Wallet Radar API","version":"1.0.0","description":"Ончейн-форензика капіталу: координація, диригенти, стратегії, ринковий контекст. Лише публічні ончейн-дані; не фінансова порада.","license":{"name":"Proprietary — All Rights Reserved"}},"servers":[{"url":"/","description":"Поточний хост"}],"components":{"securitySchemes":{"basicAuth":{"type":"http","scheme":"basic","description":"admin (повний доступ) або demo (перегляд)"}}},"security":[{"basicAuth":[]}],"tags":[{"name":"Система","description":"Здоров'я, версія, конфіг"},{"name":"Гаманці","description":"Watch-список"},{"name":"Форензика","description":"Координація, диригенти, трасування, концентрація"},{"name":"Стратегія","description":"DCA-за-китом, інституційний портфель, бектест"},{"name":"Ринок","description":"Макро-контекст, CLARITY, крос-актив"}],"paths":{"/api/health":{"get":{"summary":"Стан сервісу (версія, uptime)","tags":["Система"],"parameters":[],"responses":{"200":{"description":"OK","content":{"application/json":{}}}}}},"/api/version":{"get":{"summary":"Версія продукту","tags":["Система"],"parameters":[],"responses":{"200":{"description":"OK","content":{"application/json":{}}}}}},"/api/config":{"get":{"summary":"Конфіг + роль доступу (admin/viewer)","tags":["Система"],"parameters":[],"responses":{"200":{"description":"OK","content":{"application/json":{}}}}}},"/api/ml-status":{"get":{"summary":"Статус ML-моделі (samples, CV-точність)","tags":["Система"],"parameters":[],"responses":{"200":{"description":"OK","content":{"application/json":{}}}}}},"/api/wallets":{"get":{"summary":"Список відстежуваних гаманців","tags":["Гаманці"],"parameters":[],"responses":{"200":{"description":"OK","content":{"application/json":{}}}}},"post":{"summary":"Додати гаманець (лише admin)","tags":["Гаманці"],"responses":{"201":{"description":"Створено"},"403":{"description":"Режим перегляду"}}}},"/api/wallets/{id}":{"delete":{"summary":"Видалити гаманець (лише admin)","tags":["Гаманці"],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK"},"403":{"description":"Режим перегляду"}}}},"/api/coordination":{"get":{"summary":"Впевненість координації гаманця (0-100, доказова)","tags":["Форензика"],"parameters":[{"name":"address","in":"query","required":true,"schema":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$"},"description":"EVM-адреса 0x… (40 hex)"}],"responses":{"200":{"description":"OK","content":{"application/json":{}}},"400":{"description":"Невалідний параметр"},"429":{"description":"Ліміт (демо) або блок"}}}},"/api/conductor-network":{"get":{"summary":"Мережа суб-гаманців диригента","tags":["Форензика"],"parameters":[{"name":"address","in":"query","required":true,"schema":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$"},"description":"EVM-адреса 0x… (40 hex)"}],"responses":{"200":{"description":"OK","content":{"application/json":{}}},"400":{"description":"Невалідний параметр"},"429":{"description":"Ліміт (демо) або блок"}}}},"/api/money-trace":{"get":{"summary":"Трасування грошей до 15 колін (бюджет ≤45с)","tags":["Форензика"],"parameters":[{"name":"address","in":"query","required":true,"schema":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$"},"description":"EVM-адреса 0x… (40 hex)"},{"name":"depth","in":"query","schema":{"type":"integer","minimum":1,"maximum":15,"default":10}}],"responses":{"200":{"description":"OK","content":{"application/json":{}}},"400":{"description":"Невалідний параметр"},"429":{"description":"Ліміт (демо) або блок"}}}},"/api/concentration":{"get":{"summary":"Концентрація власників токена + стратегія DCA","tags":["Форензика"],"parameters":[{"name":"contract","in":"query","required":true,"schema":{"type":"string","pattern":"^0x[0-9a-fA-F]{40}$"},"description":"ERC-20 контракт 0x…"}],"responses":{"200":{"description":"OK","content":{"application/json":{}}},"400":{"description":"Невалідний параметр"},"429":{"description":"Ліміт (демо) або блок"}}}},"/api/con