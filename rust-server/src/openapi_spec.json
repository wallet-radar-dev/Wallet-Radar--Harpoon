ters":[],"responses":{"200":{"description":"OK","content":{"application/json":{}}}}}},"/api/check":{"get":{"summary":"Перевірка за 30 секунд: токен або гаманець → літера A–F, факти, червоні прапорці","description":"Відповідає лише з локальних даних, без мережевих запитів (~2 мс). grade: A–F — оцінка; «—» — технічна адреса (біржа, інфраструктура), ризик не оцінюється; «?» — даних немає. ВАЖЛИВО: «?» НЕ означає «безпечно», а лише «не перевіряли» — саме про це coverage.known=false. Формат стабільний і призначений і для людини, і для програмного агента.","tags":["Гаманці"],"parameters":[{"name":"q","in":"query","required":true,"description":"Адреса токена або гаманця, 0x… (40 hex)","schema":{"type":"string"}}],"responses":{"200":{"description":"Вердикт","content":{"application/json":{}}},"400":{"description":"Некоректна адреса","content":{"application/json":{}}}}}}}}