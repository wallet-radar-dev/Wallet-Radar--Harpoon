# Скопіюйте цей файл у .env і заповніть за потреби.
# Файл .env залишається ЛИШЕ на вашому компʼютері (його не комітять).

# Порт локального сервера
PORT=3000

# ── КЛЮЧІ ДО ЗОВНІШНІХ API СЮДИ НЕ КЛАДУТЬ ──
# Etherscan, Moralis, LunarCrush, Arkham, Glassnode живуть ЛИШЕ на сателітах: deploy/.env,
# по набору на кожен. Кор ходить у них по gRPC поверх mTLS і ключа не бачить — зламаний кор
# не віддає нічого цінного. Шаблон: deploy/.env.example, перевірка: deploy/check-satellite-env.sh
#
# Класти ключ сюди безглуздо: у суворому режимі (SATELLITE_ENDPOINTS у systemd-юніті) кор його
# просто ПРОІГНОРУЄ — і ви вважатимете, що він у справі. Див. docs/satellites.md.

# Секрет для перевірки підпису вебхука Moralis Streams (x-signature = keccak256(body + secret)).
# Це секрет ВХІДНИХ доставок, а не вихідний ключ, тому він і лишається на корі. Порожній —
# /webhook/moralis відповідає 503 усім (fail-closed: нічого не приймає, а не приймає будь-що).
# Moralis підписує доставки своїм API-ключем, тож сюди йде саме він — і тоді цей ключ таки лежить
# на корі. Заповнюйте, ЛИШЕ якщо реально користуєтесь Moralis Streams.
MORALIS_STREAM_SECRET=

# Ліміт частоти запитів для демо-перегляду (роль viewer). Адмін/локальний режим — без ліміту.
# RATE_LIMIT_MAX — макс. запитів з одного IP за вікно; RATE_LIMIT_WINDOW_MS — вікно в мс.
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW_MS=60000
# Авто-бан IP за зловживання: після RATE_BAN_STRIKES перевищень ліміту (429) IP блокується на RATE_BAN_MS.
RATE_BAN_STRIKES=20
RATE_BAN_MS=600000

# Ліквідаційний монітор (Bybit v5 WS, без ключа): поріг сукупних ліквідацій за 5хв,
# при якому в стрічку/Telegram пушиться подія «Ліквідаційний флеш». За замовч. $20M.
LIQ_FLUSH_USD=20000000

# DSN для GlitchTip або Sentry (необовʼязково).
# GlitchTip self-hosted: створіть проєкт → Settings → DSN.
SENTRY_DSN=

# Telegram-бот для пушів alpha-сигналів (необовʼязково).
# 1) У Telegram напиши @BotFather → /newbot → дай імʼя → отримаєш токен.
# 2) Встав токен сюди. 3) Напиши своєму боту /start — chat_id визначиться сам.
# (TELEGRAM_USERNAME — щоб ловити саме твій chat; TELEGRAM_CHAT_ID — якщо хочеш задати вручну.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_USERNAME=Vitalii_Vedana
TELEGRAM_CHAT_ID=

# ─────────────────────────── ВОРКЕРИ ───────────────────────────
# Воркери читаються при СТАРТІ сервера: змінив — перезапусти.
# Тут лишені лише ті, увімкнення яких перевірене 25.09.2026, і межі, без яких
# один із них не завершує коло.

# Імпорт публічних міток сутностей (raw.githubusercontent, без ключів, 3 МБ).
# Годує назви сутностей УСЮДИ, включно з перевіркою «біржа перекладає власні монети».
ENABLE_LABELS_WORKER=1

# Обхід балансів відстежуваних гаманців. Без нього плитка «загальна вартість»
# на головній структурно порожня.
ENABLE_BALANCES_WORKER=1

# Форензика активів: годує asset-forensics, whale-clusters, whale-positions,
# coordinated-networks, alpha-feed.
ENABLE_FORENSICS_WORKER=1
# МЕЖІ, БЕЗ ЯКИХ КОЛО НЕ ЗАВЕРШУЄТЬСЯ НІКОЛИ. Один актив коштує ~1500 звернень:
# холдери обходяться ПОСЛІДОВНО, і на кожного йде обхід кількох мереж. На 523
# активах це під мільйон запитів — воркер молотить і не зберігає нічого.
# Значення нижче дають актив за ~5 хв і повний обхід приблизно за дві доби.
# Ціна: спільний фондувальник лише в незібраній мережі не знайдеться, як і кластер,
# що тримається на 40-му холдері. Обидві межі знімаються видаленням рядка.
FORENSICS_ASSETS_PER_CYCLE=12
FORENSICS_HOLDERS=20
FORENSICS_FUNDER_CHAINS=eth,base,arbitrum,optimism,polygon

# Бектест події «кит увійшов»: публікує лише повні прогони.
ENABLE_BACKTEST_WORKER=1

# Свідомо ВИМКНЕНІ (не вмикати без причини):
#   ENABLE_EXPAND_WORKER   краулер графа — їсть квоту
#   ENABLE_ML_WORKER       тренування моделі
#   ENABLE_UNIVERSE_WORKER CoinGecko free-tier впирається в 429
#   ENABLE_BACKUP_WORKER   пише бекап на 204 ГБ
